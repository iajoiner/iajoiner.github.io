---
/**
 * National flags as small inline SVGs, drawn to each flag's official
 * proportions and colours. The label names the flag for screen readers.
 */
import type { FlagCode } from "../i18n/home";

interface Props {
  code: FlagCode;
  label: string;
}

const { code, label } = Astro.props;

const VIEW: Record<FlagCode, [number, number]> = {
  dk: [37, 28],
  fi: [18, 11],
  is: [25, 18],
  no: [22, 16],
  se: [16, 10],
  ee: [33, 21],
  pl: [8, 5],
  us: [190, 100],
};

/** The US flag's 50 stars: nine rows, alternately six and five (official specification, scaled to 190 × 100). */
function star(cx: number, cy: number, r: number): string {
  return Array.from({ length: 10 }, (_, i) => {
    const a = (Math.PI / 5) * i - Math.PI / 2;
    const d = i % 2 === 0 ? r : r * 0.382;
    return `${(cx + d * Math.cos(a)).toFixed(2)},${(cy + d * Math.sin(a)).toFixed(2)}`;
  }).join(" ");
}
const usStars =
  code === "us"
    ? Array.from({ length: 9 }, (_, row) =>
        Array.from({ length: row % 2 === 0 ? 6 : 5 }, (_, col) => star((row % 2 === 0 ? 6.3 : 12.6) + col * 12.6, 5.4 + row * 5.4, 3.08)),
      ).flat()
    : [];
const [w, h] = VIEW[code];
---

<svg class="flag" viewBox={`0 0 ${w} ${h}`} width={Math.round((w / h) * 24)} height="24" role="img" aria-label={label}>
  {
    code === "dk" && (
      <>
        <rect width="37" height="28" fill="#C8102E" />
        <rect x="12" width="4" height="28" fill="#fff" />
        <rect y="12" width="37" height="4" fill="#fff" />
      </>
    )
  }
  {
    code === "fi" && (
      <>
        <rect width="18" height="11" fill="#fff" />
        <rect x="5" width="3" height="11" fill="#002F6C" />
        <rect y="4" width="18" height="3" fill="#002F6C" />
      </>
    )
  }
  {
    code === "is" && (
      <>
        <rect width="25" height="18" fill="#02529C" />
        <rect x="7" width="4" height="18" fill="#fff" />
        <rect y="7" width="25" height="4" fill="#fff" />
        <rect x="8" width="2" height="18" fill="#DC1E35" />
        <rect y="8" width="25" height="2" fill="#DC1E35" />
      </>
    )
  }
  {
    code === "no" && (
      <>
        <rect width="22" height="16" fill="#BA0C2F" />
        <rect x="6" width="4" height="16" fill="#fff" />
        <rect y="6" width="22" height="4" fill="#fff" />
        <rect x="7" width="2" height="16" fill="#00205B" />
        <rect y="7" width="22" height="2" fill="#00205B" />
      </>
    )
  }
  {
    code === "se" && (
      <>
        <rect width="16" height="10" fill="#006AA7" />
        <rect x="5" width="2" height="10" fill="#FECC02" />
        <rect y="4" width="16" height="2" fill="#FECC02" />
      </>
    )
  }
  {
    code === "ee" && (
      <>
        <rect width="33" height="7" fill="#0072CE" />
        <rect y="7" width="33" height="7" fill="#000" />
        <rect y="14" width="33" height="7" fill="#fff" />
      </>
    )
  }
  {
    code === "us" && (
      <>
        <rect width="190" height="100" fill="#fff" />
        {Array.from({ length: 7 }, (_, i) => (
          <rect y={(i * 200) / 13} width="190" height={100 / 13} fill="#B31942" />
        ))}
        <rect width="76" height={700 / 13} fill="#0A3161" />
        {usStars.map((points) => (
          <polygon points={points} fill="#fff" />
        ))}
      </>
    )
  }
  {
    code === "pl" && (
      <>
        <rect width="8" height="2.5" fill="#fff" />
        <rect y="2.5" width="8" height="2.5" fill="#DC143C" />
      </>
    )
  }
</svg>
