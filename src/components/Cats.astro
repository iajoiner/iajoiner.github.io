---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

import Base from "../layouts/Base.astro";
import Emoji from "./Emoji.astro";
import type { Lang } from "../i18n/languages";
import { STRINGS } from "../i18n/strings";
import captions from "../assets/cats/captions.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = STRINGS[lang].cats;

/**
 * Every photo in src/assets/cats/<folder>/ is shown, newest file name first.
 * A caption comes from captions.json ("<folder>/<file>": { en, es, sv, fi }) if
 * the photo has one there; otherwise it is the file name with dashes as
 * spaces, without its extension and without a leading date (and a "-2"
 * after it): "2026-11-16-chloe-on-the-sofa.jpg" is "chloe on the sofa",
 * and "2026-11-16.jpg" has none. See README.md.
 */
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/cats/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", {
  eager: true,
});

async function photosIn(folder: string) {
  const list = Object.entries(files)
    .filter(([path]) => path.split("/").at(-2) === folder)
    .sort(([a], [b]) => b.localeCompare(a))
    .map(([path, mod]) => {
      const file = path.split("/").at(-1) ?? "";
      const given = (captions as Record<string, Partial<Record<Lang, string>>>)[`${folder}/${file}`];
      const caption = given?.[lang] ?? given?.en ?? file
        .replace(/\.[^.]+$/, "")
        .replace(/^\d{4}-\d{2}-\d{2}(-\d+)?-?/, "")
        .replace(/[-_]+/g, " ")
        .trim();
      return { src: mod.default, caption };
    });
  // The link opens a larger copy (at most 1600 pixels wide), not the camera original.
  return Promise.all(
    list.map(async (p) => ({ ...p, full: (await getImage({ src: p.src, width: Math.min(1600, p.src.width) })).src })),
  );
}

const sections = [
  { id: "chloe", title: t.chloe, emoji: "🐱", photos: await photosIn("chloe") },
  { id: "margaret", title: t.margaret, emoji: "😸", photos: await photosIn("margaret") },
  { id: "street", title: t.street, emoji: "🐈", photos: await photosIn("street") },
];
---

<Base lang={lang} title={t.title} page="cats">
  <h1>{t.title} <Emoji e="🐾" /></h1>
  <p class="lead">{t.intro}</p>
  {
    sections.map((s) => (
      <section aria-labelledby={s.id}>
        <h2 id={s.id}>{s.title} <Emoji e={s.emoji} /></h2>
        {s.photos.length === 0 ? (
          <p class="meta">{t.empty} <Emoji e="😿" /></p>
        ) : (
          <ul class="gallery">
            {s.photos.map((p) => (
              <li>
                <figure>
                  <a href={p.full}>
                    <Image src={p.src} alt={p.caption || s.title} width={480} height={480} fit="cover" loading="lazy" />
                  </a>
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Base>
