---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Base from "../layouts/Base.astro";
import CrossMark from "./CrossMark.astro";
import Emoji from "./Emoji.astro";
import RichText from "./RichText.astro";
import { HOME, ORGS, type OrgKey } from "../i18n/home";
import { STRINGS } from "../i18n/strings";
import type { Lang } from "../i18n/languages";
import coauthored from "../assets/orgs/coauthored.svg";
import gideon from "../assets/orgs/gideon.svg";
import haapavesi from "../assets/orgs/haapavesi.svg";
import lumenary from "../assets/orgs/lumenary.svg";
import omh from "../assets/orgs/omh.png";
import pcg from "../assets/orgs/pcg.png";
import drawnCat from "../assets/cat-face.svg";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = HOME[lang];
const ICONS: Record<OrgKey, ImageMetadata> = { gideon, omh, lumenary, pcg, haapavesi, coauthored };

/** My face is a cat: src/assets/cats/face.jpg (or .png, .webp) once there is one, a drawn cat until then. */
const faces = import.meta.glob<{ default: ImageMetadata }>("../assets/cats/face.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}", { eager: true });
const face = Object.values(faces)[0]?.default ?? drawnCat;
---

<Base lang={lang} title="Ian Alexander Joiner" page="home">
  <section class="hero" aria-labelledby="name">
    <div class="hero-head">
      <Image src={face} alt="" width={128} height={128} class="face" loading="eager" />
      <h1 id="name">Ian Alexander Joiner</h1>
    </div>
    <p class="tagline"><span lang="en">Christ, Code, Cats.</span> <span class="nowrap"><CrossMark /> <Emoji e="🐧" /> <Emoji e="🐈" /></span></p>
    {h.taglineGloss && <p class="gloss">{h.taglineGloss}</p>}
    <p class="motto" lang="fi">Usko, toivo, rakkaus.</p>
    <p class="gloss">{h.mottoGloss}</p>
    <p class="lead">{h.intro}</p>
    <p><RichText text={h.bio} /></p>
    <p class="catbro"><Emoji e="😺" /> {h.catBro} <Emoji e="🐾" /></p>
    <ul class="favorites">
      <li>{h.favLanguage}: <strong>Rust</strong> <Emoji e="🦀" /></li>
      <li>{h.favOs}: <strong>Linux</strong></li>
      <li>{STRINGS[lang].email}: <a href="mailto:ian@gideonsolutions.us">ian@gideonsolutions.us</a></li>
    </ul>
  </section>

  <section aria-labelledby="orgs">
    <h2 id="orgs">{h.orgsTitle}</h2>
    <ul class="cards">
      {
        ORGS.map((o) => (
          <li class="card">
            <div class="card-head">
              <Image src={ICONS[o.key]} alt="" width={48} height={48} class="org-icon" />
              <h3>{o.name}</h3>
            </div>
            <p>{h.orgs[o.key]}</p>
            <p class="links">
              {o.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

</Base>
