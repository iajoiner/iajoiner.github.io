---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Base from "../layouts/Base.astro";
import Emoji from "./Emoji.astro";
import Flag from "./Flag.astro";
import { COUNTRY_FLAGS, FLAG_NAMES, HOME, ORGS, type OrgKey } from "../i18n/home";
import type { Lang } from "../i18n/languages";
import coauthored from "../assets/orgs/coauthored.svg";
import gideon from "../assets/orgs/gideon.svg";
import haapavesi from "../assets/orgs/haapavesi.svg";
import lumenary from "../assets/orgs/lumenary.svg";
import omh from "../assets/orgs/omh.png";
import pcg from "../assets/orgs/pcg.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = HOME[lang];
const ICONS: Record<OrgKey, ImageMetadata> = { gideon, omh, lumenary, pcg, haapavesi, coauthored };
---

<Base lang={lang} title="Ian Alexander Joiner" page="home">
  <section class="hero" aria-labelledby="name">
    <h1 id="name">Ian Alexander Joiner</h1>
    <p class="tagline"><span lang="en">Christ, Code, Cats.</span> <Emoji e="✝️" /> <Emoji e="🐧" /> <Emoji e="🐈" /></p>
    {h.taglineGloss && <p class="gloss">{h.taglineGloss}</p>}
    <p class="motto" lang="fi">Usko, toivo, rakkaus.</p>
    <p class="gloss">{h.mottoGloss}</p>
    <p class="lead">{h.intro}</p>
    <p class="catbro"><Emoji e="😺" /> {h.catBro} <Emoji e="🐾" /></p>
    <ul class="favorites">
      <li>{h.favLanguage}: <strong>Rust</strong> <Emoji e="🦀" /></li>
      <li>{h.favOs}: <strong>Linux</strong> <Emoji e="🐧" /></li>
    </ul>
  </section>

  <section aria-labelledby="orgs">
    <h2 id="orgs">{h.orgsTitle}</h2>
    <ul class="cards">
      {
        ORGS.map((o) => (
          <li class="card">
            <div class="card-head">
              <Image src={ICONS[o.key]} alt="" width={48} height={48} class="org-icon" />
              <h3>{o.name}</h3>
            </div>
            <p>{h.orgs[o.key]}</p>
            <p class="links">
              {o.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="countries">
    <h2 id="countries">{h.countriesTitle}</h2>
    <p>{h.countriesIntro}</p>
    {
      h.countries.map((c, i) => (
        <div class="country">
          <h3>{c.name}</h3>
          <p class="flags">
            {(COUNTRY_FLAGS[i] ?? []).map((f) => (
              <Flag code={f} label={FLAG_NAMES[lang][f]} />
            ))}
          </p>
          <ul>
            {c.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section aria-labelledby="roots">
    <h2 id="roots">{h.rootsTitle}</h2>
    <p class="flags"><Flag code="us" label={FLAG_NAMES[lang].us} /></p>
    {h.roots.map((r) => <p>{r}</p>)}
  </section>
</Base>
