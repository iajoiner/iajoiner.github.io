---
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import { LANG_NAMES, LANGS, pathFor, type Lang } from "../../i18n/languages";
import { publishedPosts, versionsOf } from "../../i18n/posts";
import { STRINGS } from "../../i18n/strings";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, versions: versionsOf(post, posts) } }));
}

const { post, versions } = Astro.props;
const alternates = Object.fromEntries(Object.entries(versions).map(([l, p]) => [l, `/blog/${p!.id}/`])) as Partial<Record<Lang, string>>;
const others = LANGS.filter((l) => l !== post.data.lang && versions[l]);
const { Content } = await render(post);
const lang = post.data.lang;
const t = STRINGS[lang].blog;
const date = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" }).format(post.data.date);
---

<Base lang={lang} title={post.data.title} description={post.data.summary} alternates={alternates}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
      {others.length > 0 && (
        <>
          {" · "}{t.alsoIn}:{" "}
          {others.map((l, i) => (
            <>
              {i > 0 && " · "}
              <a href={alternates[l]} lang={l} hreflang={l}>{LANG_NAMES[l]}</a>
            </>
          ))}
        </>
      )}
    </p>
    <div class="post-body">
      <Content />
    </div>
  </article>
  <p><a href={pathFor(lang, "blog")}>← {t.all}</a></p>
</Base>
